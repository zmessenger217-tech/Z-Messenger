# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# WEBSOCKET_APP_KEY: Real-time signaling app key for WebSocket connectivity
WEBSOCKET_APP_KEY="app_8c3ff14ca7014206f19972b858b03ee42555b2a1"

# WEBSOCKET_SECRET: Real-time signaling secret for WebSocket connectivity
WEBSOCKET_SECRET="c668ed4b9881084ec5d3184fbeaf941a6b39b4b05d0025b123af3caf0df7084a"

# APINATOR Real-time WebSocket credentials
APINATOR_APP_ID="b93128ee-a389-4c23-aafa-eebf7c379b33"
APINATOR_KEY="app_8c3ff14ca7014206f19972b858b03ee42555b2a1"
APINATOR_SECRET="c668ed4b9881084ec5d3184fbeaf941a6b39b4b05d0025b123af3caf0df7084a"

